{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2023"],

    "rootDir": ".",

    "baseUrl": ".",

    "paths": {
      "@common/*": ["src/common/*"],
      "@config/*": ["config/*"],
      "@core/*": ["src/core/*"],
      "@pages/*": ["src/pageobjects/*"],
      "@tests/*": ["tests/*"],
      "@utils/*": ["src/common/utils/*"],
      "@logger/*": ["src/common/logger/*"],
      "@ai/*": ["src/ai/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@cucumber/*": ["src/cucumber/*"]
    },

    "resolveJsonModule": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "noImplicitAny": true,

    "strictNullChecks": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,

    "sourceMap": true,

    "declaration": false,

    "removeComments": false,

    "types": [
      "node"
    ]
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "reports",
    "artifacts",
    "dist"
  ]
}